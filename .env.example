APP_BROWSER_SECRET=replace-with-at-least-32-random-characters
DETECTOR_PORT=3056
DETECTOR_IMAGE=ghcr.io/carminback/gpt56_api_detector:latest
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
# 留空表示不限制；设置为目标群 ID（通常形如 -100...）后仅该群可用，可逗号分隔多个群
TELEGRAM_ALLOWED_CHAT_IDS=
DETECTOR_API_URL=https://check.mewinyou.shop
BOT_MAX_CONCURRENT_CHECKS=2
BOT_POLL_INTERVAL_SECONDS=3
BOT_JOB_TIMEOUT_SECONDS=1800
